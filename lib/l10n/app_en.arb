  "welcomeHeroTitle": "Welcome to PLPCG!",
  "welcomeHeroSubtitle": "The digital hymnal and praise organizer for musicians, instrumentalists, and worship teams.",
  "welcomeHeroFeatureSearch": "Fast search by number, title, rhythm, and tags.",
  "welcomeHeroFeaturePlaylists": "Create playlists and setlists for worship services.",
