.env.*
!.env.example
!.env.*.example

credentials.json
credentials.yaml
credentials.yml
secrets.json
secrets.yaml
secrets.yml

*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
id_rsa
id_ed25519
id_ed25519_sk
service-account*.json

# Overrides locais de --dart-define-from-file (plpcg.json permanece versionado)
dart_defines/*.local.json
dart_defines/local.json
dart_defines/private.json
dart_defines/*.secret.json

# Fastlane / assinatura (iOS/Android)
