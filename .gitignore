.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~

# Cursor — estado de runtime dos hooks (não versionar)
.cursor/hooks/.loop-state

# --- Segredos e credenciais (nunca commitar) ---------------------------------
