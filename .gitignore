# =============================================================================
# coldigui — Flutter 3 / Dart 3.5+ (iOS; Riverpod, Isar, build_runner, l10n)
# =============================================================================

# --- Flutter / Dart / Pub ----------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/doc/api/
.flutter-plugins
.flutter-plugins-dependencies
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

# Codegen / coverage (mantém *.g.dart do Isar e l10n versionados)
coverage/
.test_coverage.dart
.test_runner.dart

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Native libs copiadas localmente (ex.: libisar.dylib na raiz)
*.dylib
*.so
*.dll

# --- iOS ---------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Pods/
**/ios/.symlinks/
**/ios/**/xcuserdata/
**/ios/**/DerivedData/
**/ios/**/*.xcuserstate
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/dgph
**/ios/**/profile

# --- Android (quando a plataforma for adicionada) ----------------------------
